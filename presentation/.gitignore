# Fișiere temporare HyperFrames și randări intermediare (exporturile finale stau în presentation/exports/)
video/.hyperframes/
video/renders/
video/boards/.film.html
video/boards/.posed.html
# Muzica se regenerează din compose.py; în git intră doar varianta comprimată folosită în video
music/out/*.wav
music/out/stems/
music/out/stems_120/
music/out/stems_v3/

# Originalele PNG ale imaginilor generate (în git intră variantele JPEG din video/assets/img/)
assets/gen/*.png
video/boards/stills/

# Originalele PNG ale obiectelor 3D (în video intră copiile tăiate din video/assets/3d/)
assets/gen3d/*.png

# Folderele de lucru ale agenților 3D (Blender, cadre, arhive): rămân locale; în video intră doar foile alese, în video/assets/3d/
assets/3d-astra/
assets/3d-sol/
music/out/*_asculta.mp4

# Audio: doar pe disc, în afara git-ului (regula lui Teo, 7 nov., 17:15). Se refac cu `make music`.
music/out/*.m4a
video/assets/audio/*.flac

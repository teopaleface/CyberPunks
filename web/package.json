{
  "name": "cyberpunks-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun scripts/copy-maplibre-worker.ts && bun scripts/build-landing.ts && next dev -p 3710",
    "build": "bun scripts/copy-maplibre-worker.ts && bun scripts/build-landing.ts && next build",
    "start": "next start -p 3710",
    "lint": "eslint",
    "gen:types": "bun scripts/gen-types.ts",
    "test": "bun test",
    "worker": "bun scripts/copy-maplibre-worker.ts",
    "smoke": "bun scripts/smoke.ts",
    "landing": "bun scripts/build-landing.ts --force",
    "cf:build": "bun scripts/copy-maplibre-worker.ts && bun scripts/build-landing.ts && bun scripts/cloudflare-data.ts && CF_BUILD=1 opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.70.0",
    "maplibre-gl": "^6.16.0",
    "motion": "^14.10.1",
    "next": "16.4.5",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.16",
    "@tailwindcss/turbopack": "^4",
    "@types/bun": "^1.4.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "json-schema-to-typescript": "^16.0.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "4.158.0"
  },
  "packageManager": "bun@1.3.11",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}

{
  "$defs": {
    "Confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "title": "Confidence",
      "type": "string"
    },
    "CrewSkill": {
      "enum": [
        "metering",
        "lv_grid",
        "mv_grid"
      ],
      "title": "CrewSkill",
      "type": "string"
    },
    "RecommendedAction": {
      "enum": [
        "inspect_on_site",
        "remote_reading",
        "watchlist",
        "human_review",
        "preposition_crew",
        "adjust_tap",
        "measurement_campaign",
        "notify_customers",
        "office_correction",
        "grid_inspection",
        "phase_rebalance",
        "offer_battery",
        "export_limit",
        "transformer_upgrade",
        "no_action"
      ],
      "title": "RecommendedAction",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "O treaptă din scara de soluții pentru tensiune (C), în `WorkItem.extra[\"remedy_options\"]` (listă).\n\nEfectul se calculează cu calculul de rețea al lui C, nu se ghicește.",
  "properties": {
    "action": {
      "$ref": "#/$defs/RecommendedAction"
    },
    "cost_lei": {
      "minimum": 0.0,
      "title": "Cost Lei",
      "type": "number"
    },
    "p90_after_pu": {
      "description": "P90 al tensiunii maxime după soluție",
      "exclusiveMaximum": 1.5,
      "exclusiveMinimum": 0.5,
      "title": "P90 After Pu",
      "type": "number"
    },
    "effect_pu": {
      "description": "Cât scade P90 (pu), negativ = scade",
      "title": "Effect Pu",
      "type": "number"
    },
    "confidence": {
      "$ref": "#/$defs/Confidence"
    },
    "duration_min": {
      "description": "Timp de lucru; 0 pentru mesaje",
      "minimum": 0,
      "title": "Duration Min",
      "type": "integer"
    },
    "needs_crew": {
      "title": "Needs Crew",
      "type": "boolean"
    },
    "crew_skill": {
      "anyOf": [
        {
          "$ref": "#/$defs/CrewSkill"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "combinable": {
      "default": true,
      "description": "Se poate combina cu alte trepte",
      "title": "Combinable",
      "type": "boolean"
    },
    "note_ro": {
      "title": "Note Ro",
      "type": "string"
    },
    "participation_rate": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Rata de participare folosită (IPOTEZĂ)",
      "title": "Participation Rate"
    },
    "risk_hours": {
      "description": "Orele cu risc vizate, de exemplu ['12:00-15:00']",
      "items": {
        "type": "string"
      },
      "title": "Risk Hours",
      "type": "array"
    },
    "inverter_trips_avoided": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Opriri ale invertoarelor evitate",
      "title": "Inverter Trips Avoided"
    },
    "message_preview_ro": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Textul de grup, pe post, fără date personale",
      "title": "Message Preview Ro"
    },
    "customers_targeted": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Customers Targeted"
    },
    "battery_kwh_total": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "kWh de baterii propuși, total pe post",
      "title": "Battery Kwh Total"
    },
    "revenue_lei": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Venit estimat pentru PPC Energie",
      "title": "Revenue Lei"
    },
    "payback_years": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Perioada de recuperare pentru client",
      "title": "Payback Years"
    }
  },
  "required": [
    "action",
    "cost_lei",
    "p90_after_pu",
    "effect_pu",
    "confidence",
    "duration_min",
    "needs_crew",
    "note_ro"
  ],
  "title": "RemedyOption",
  "type": "object"
}
